# Telegram: token generado por BotFather. Nunca subas el valor real.
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN_DE_BOTFATHER
# 1-256 caracteres alfanuméricos, guion bajo o guion. Debe mantenerse secreto.
TELEGRAM_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO

# ngrok: token de cuenta y dominio estático reservado en el dashboard.
NGROK_AUTHTOKEN=REEMPLAZAR_CON_TOKEN_DE_NGROK
NGROK_DOMAIN=REEMPLAZAR_CON_DOMINIO_RESERVADO.ngrok-free.app

# Deben ser contraseñas locales robustas, sin caracteres reservados de URL en RabbitMQ.
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL
RABBITMQ_USER=bandeja
RABBITMQ_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL

WEB_PORT=8088
